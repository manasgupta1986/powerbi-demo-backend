{
  "manifest_version": 3,
  "name": "PowerBI Demo Assistant",
  "version": "1.2.0",
  "description": "Demo assistant for dashboard capture, saved reports, and Q&A.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "sidePanel"],
  "host_permissions": [
    "https://app.powerbi.com/*",
    "https://*.onrender.com/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open PowerBI Demo Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://app.powerbi.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
