{
  "manifest_version": 3,
  "name": "PowerBI Demo Assistant",
  "version": "4.0.0",
  "description": "Guided semi-automated Power BI capture assistant with AI extraction and closed-book Q&A",
  "permissions": ["storage", "tabs", "activeTab", "sidePanel"],
  "host_permissions": [
    "https://app.powerbi.com/*",
    "https://*.powerbi.com/*",
    "https://*.onrender.com/*",
    "http://localhost/*",
    "http://localhost:*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "PowerBI Demo Assistant"
  },
  "content_scripts": [
    {
      "matches": ["https://app.powerbi.com/*", "https://*.powerbi.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
